# Copy to deploy/.env and fill in. For BYO-bucket, use your S3/R2 values.
# For local evaluation with the bundled MinIO, keep these defaults and run:
#   docker compose --env-file deploy/.env -f deploy/docker-compose.yml --profile local-s3 up -d
FORGE_S3_ENDPOINT=minio:9000
FORGE_S3_BUCKET=forge
FORGE_S3_ACCESS_KEY=forge
FORGE_S3_SECRET_KEY=change-me-please
FORGE_S3_USE_SSL=false
